# Application Settings
APP_NAME="FlyAsh Intel API"
APP_ENV="development"
VERSION="0.1.0"
API_V1_STR="/api"
HOST="127.0.0.1"
PORT=8000

# Verified local development origins for React Vite frontend
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Persistence & Data Schema
DATABASE_URL="sqlite:///./backend/data/flyash.db"
CANONICAL_SCHEMA_VERSION="v1.0.0-canonical"

# Document Ingestion & Storage
MAX_UPLOAD_SIZE_BYTES=15728640
DOCUMENTS_STORAGE_DIR="backend/data/documents"

