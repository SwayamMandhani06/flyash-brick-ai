# ==============================================================================
# FlyAsh Intel — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local or .env for local environment configuration:
# cp .env.example .env.local
#
# NOTE: Never commit secret keys or sensitive credentials to version control.
# ==============================================================================

# API Base URL for Python Backend (FastAPI / Flask)
# When VITE_USE_MOCK_API is true, frontend services use simulated responses.
VITE_API_BASE_URL=http://localhost:8000

# Feature Flag: Enable/Disable Client-Side Mock Data & Simulations
# Set to 'false' to route requests to the live Python backend endpoints.
# Set to 'true' (default) to run frontend in standalone demonstration mode.
VITE_USE_MOCK_API=true

# Application Environment ('development' | 'production' | 'test')
VITE_APP_ENV=development

# Benchmark Schema Version
VITE_BENCHMARK_SCHEMA_VERSION=v0.1.0-canonical
